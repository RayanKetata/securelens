DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/securelens
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Apply database migrations on startup. Set to false to run
# "python -m alembic upgrade head" yourself (e.g. several workers).
AUTO_MIGRATE=true
# OCR for scanned PDFs uses the Tesseract program when it is installed.
# Set TESSERACT_CMD to its full path if it is not on PATH, e.g.
# C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_ENABLED=true
TESSERACT_CMD=tesseract
OCR_LANGUAGES=eng
